<Window x:Class="MeshHunter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeshHunter — Asset Inspector" Height="820" Width="1320" MinHeight="600" MinWidth="900"
        Background="{StaticResource WindowBrush}" Foreground="#FFE8EAF0">
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="#FF252A33" Foreground="#FFE8EAF0">
      <MenuItem Header="_File">
        <MenuItem Header="_Import…" Click="Import_Click" InputGestureText="Ctrl+O" />
        <MenuItem Header="_Export selected mesh…" Click="Export_Click" InputGestureText="Ctrl+E" />
        <Separator/>
        <MenuItem Header="E_xit" Click="Exit_Click" />
      </MenuItem>
    </Menu>
    <StatusBar DockPanel.Dock="Bottom" Background="#FF252A33" Foreground="#FFCFD5DF">
      <StatusBarItem><TextBlock x:Name="StatusText" Text="Ready — import files or a folder, then analyze." /></StatusBarItem>
    </StatusBar>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="350" MinWidth="270" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" Padding="12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Asset Inspector" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="SourceText" Text="No input selected" TextWrapping="Wrap" Foreground="#FFAFB8C6" Margin="0,5,0,10" />
            <WrapPanel Margin="0,0,0,10">
              <Button Content="Import files…" Click="Import_Click" Padding="12,6" Margin="0,0,8,0" />
              <Button Content="Choose folder…" Click="ImportFolder_Click" Padding="12,6" />
            </WrapPanel>
            <Button Content="Analyze" Click="Analyze_Click" Padding="10,7" Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold" />
            <TextBlock Text="Discovered assets" FontWeight="SemiBold" Margin="0,14,0,6" />
          </StackPanel>
          <ListBox x:Name="AssetList" SelectionMode="Extended" SelectionChanged="AssetList_SelectionChanged"
                   PreviewMouseRightButtonDown="AssetList_PreviewMouseRightButtonDown"
                   Background="#FF181B21" Foreground="#FFE8EAF0" BorderBrush="#FF3A414D">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Export selected mesh(es) as…">
                  <MenuItem Header="Wavefront OBJ (.obj)" Tag=".obj" Click="ExportSelectedMeshes_Click" />
                  <MenuItem Header="glTF JSON (.gltf)" Tag=".gltf" Click="ExportSelectedMeshes_Click" />
                  <MenuItem Header="Binary glTF (.glb)" Tag=".glb" Click="ExportSelectedMeshes_Click" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Export selected textures…" Click="ExportSelectedTextures_Click" />
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemContainerStyle>
              <Style TargetType="{x:Type ListBoxItem}">
                <Setter Property="Foreground" Value="#FFE8EAF0" />
                <Setter Property="Background" Value="#FF181B21" />
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF343D4B" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF4E9BE8" />
                    <Setter Property="Foreground" Value="White" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#FF3A414D" />
      <Grid Grid.Column="2" Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="180" MinHeight="120" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FF111318" BorderBrush="#FF343A45" BorderThickness="1" CornerRadius="4">
          <Viewport3D x:Name="MeshViewport" ClipToBounds="True" Focusable="True"
                      MouseLeftButtonDown="MeshViewport_MouseLeftButtonDown" MouseLeftButtonUp="MeshViewport_MouseLeftButtonUp"
                      MouseMove="MeshViewport_MouseMove" MouseWheel="MeshViewport_MouseWheel">
            <Viewport3D.Camera><PerspectiveCamera Position="4,3,5" LookDirection="-4,-3,-5" UpDirection="0,1,0" FieldOfView="45" /></Viewport3D.Camera>
            <ModelVisual3D>
              <ModelVisual3D.Content><Model3DGroup><AmbientLight Color="#FF777777" /><DirectionalLight Color="White" Direction="-1,-2,-3" /></Model3DGroup></ModelVisual3D.Content>
            </ModelVisual3D>
            <ModelVisual3D x:Name="MeshVisual" />
          </Viewport3D>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="#FF343A45" BorderThickness="1" Padding="12" Margin="0,10,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,12,0">
              <TextBlock DockPanel.Dock="Top" Text="Selection details" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
              <TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="#FFCFD5DF" BorderThickness="0" />
            </DockPanel>
            <Border Grid.Column="1" Background="#FF181B21" BorderBrush="#FF343A45" BorderThickness="1" Padding="10">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Activity" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <TextBlock x:Name="ActivityText" Text="Ready — waiting for files to analyze." Foreground="#FFCFD5DF" TextWrapping="Wrap" />
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
